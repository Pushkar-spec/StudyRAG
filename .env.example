# StudyRAG Environment Configuration
# Copy this file to .env and fill in your keys (DO NOT commit your real .env file)

# Gemini API Key (Provisional model: gemini-2.5-flash-lite; required for grading/LLM workflows in later steps)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default application home directory (defaults to ~/.studyrag if unset)
# STUDYRAG_HOME=C:\Users\username\.studyrag
